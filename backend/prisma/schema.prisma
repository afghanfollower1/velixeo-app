generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AppLocale {
  FA
  EN
}

enum DisplayCurrency {
  AFN
  USD
  TOMAN
}

enum WalletEntryType {
  DEPOSIT
  PURCHASE
  REFUND
  MANUAL_CREDIT
  MANUAL_DEBIT
  ADJUSTMENT
}

enum WalletEntryStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum ServiceCategory {
  SOCIAL
  VIRTUAL_NUMBER
  PREMIUM
  DIGITAL_ACCOUNT
  MOBILE_TOPUP
  PROMOTION
}

enum ProviderKind {
  SOCIAL
  VIRTUAL_NUMBER
  TOPUP
  PREMIUM
  PAYMENT
  GENERIC
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  AWAITING_SMS
  CANCELLED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum BannerPlacement {
  HOME_HERO
  HOME_INLINE
  SERVICES_TOP
  WALLET_TOP
}

enum CouponDiscountType {
  FIXED_AFN
  PERCENT
}

enum NotificationAudience {
  ALL
  USER
}

enum NotificationType {
  SYSTEM
  ORDER
  PAYMENT
  WALLET
  REFILL
  DRIPFEED
  SUPPORT
  PROMOTION
  ACCOUNT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
}

enum SupportStatus {
  OPEN
  PENDING_USER
  PENDING_ADMIN
  RESOLVED
  CLOSED
}

model User {
  id              String          @id @default(uuid())
  fullName        String?
  email           String?         @unique
  phone           String?         @unique
  passwordHash    String?
  googleSubject   String?         @unique
  role            UserRole        @default(USER)
  status          UserStatus      @default(ACTIVE)
  locale          AppLocale       @default(FA)
  displayCurrency DisplayCurrency @default(AFN)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  wallet                Wallet?
  refreshTokens         RefreshToken[]
  orders                Order[]
  payments              PaymentTransaction[]
  supportTickets        SupportTicket[]
  supportMessages       SupportMessage[]       @relation("SupportSender")
  notifications         Notification[]
  notificationReads     NotificationRead[]
  pushDevices           PushDevice[]
  auditLogs             AdminAuditLog[]        @relation("AdminAuditLogs")
}

model Wallet {
  id         String   @id @default(uuid())
  userId     String   @unique
  balanceAfn BigInt   @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries WalletEntry[]
}

model WalletEntry {
  id              String            @id @default(uuid())
  walletId        String
  type            WalletEntryType
  status          WalletEntryStatus @default(COMPLETED)
  amountAfn       BigInt
  balanceAfterAfn BigInt
  referenceType   String?
  referenceId     String?
  description     String?
  metadata        Json?
  idempotencyKey  String?           @unique
  createdAt       DateTime          @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ExchangeRate {
  id         String   @id @default(uuid())
  code       String   @unique
  afnPerUnit Decimal  @db.Decimal(20, 8)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

model Provider {
  id                   String       @id @default(uuid())
  name                 String
  slug                 String       @unique
  kind                 ProviderKind
  baseUrl              String?
  enabled              Boolean      @default(true)
  priority             Int          @default(100)
  defaultMarkupPercent Decimal      @default(0) @db.Decimal(10, 2)
  timeoutSeconds       Int          @default(30)
  notes                String?
  secretCiphertext     String?
  secretIv             String?
  secretTag            String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  routes   ServiceProviderRoute[]
  orders   Order[]
  payments PaymentTransaction[]

  @@index([kind, enabled, priority])
}

model Service {
  id             String          @id @default(uuid())
  category       ServiceCategory
  slug           String          @unique
  titleFa        String
  titleEn        String
  descriptionFa String?
  descriptionEn String?
  enabled        Boolean         @default(true)
  featured       Boolean         @default(false)
  sortOrder      Int             @default(100)
  basePriceAfn   BigInt?
  priceUnit      Int             @default(1)
  minQty         Int?
  maxQty         Int?
  socialPlatform String?
  socialGroup    String?
  estimatedMinMinutes Int?
  estimatedMaxMinutes Int?
  refillDays     Int?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  routes ServiceProviderRoute[]
  orders Order[]

  @@index([category, enabled, sortOrder])
}

model ServiceProviderRoute {
  id                  String   @id @default(uuid())
  serviceId           String
  providerId          String
  providerServiceCode String
  enabled             Boolean  @default(true)
  priority            Int      @default(100)
  costAfn             BigInt?
  markupPercent       Decimal? @db.Decimal(10, 2)
  providerName        String?
  providerType        String?
  providerCategory    String?
  providerRate        Decimal? @db.Decimal(20, 8)
  providerCurrency    String?
  providerMinQty      Int?
  providerMaxQty      Int?
  providerRefill      Boolean  @default(false)
  providerCancel      Boolean  @default(false)
  lastSyncedAt        DateTime?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([serviceId, providerId, providerServiceCode])
  @@index([serviceId, enabled, priority])
  @@index([providerId, enabled])
}

model Order {
  id                   String          @id @default(uuid())
  userId               String
  serviceId            String?
  providerId           String?
  category             ServiceCategory
  status               OrderStatus     @default(PENDING)
  quantity             Int?
  baseAmountAfn        BigInt
  totalAmountAfn       BigInt
  providerCostAfn      BigInt?
  providerOrderId      String?
  publicOrderNumber    BigInt?
  clientRequestId      String?         @unique
  input                Json?
  output               Json?
  exchangeRateSnapshot Json?
  failureReason        String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  completedAt          DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  actions  OrderActionLog[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([providerId, providerOrderId])
  @@index([publicOrderNumber])
}

model OrderActionLog {
  id                String   @id @default(uuid())
  orderId           String
  action            String
  status            String
  providerReference String?
  response          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([action, status])
}

model PaymentTransaction {
  id             String        @id @default(uuid())
  userId         String
  providerId     String?
  gateway        String        @default("HESABPAY")
  status         PaymentStatus @default(PENDING)
  amountAfn      BigInt
  externalId     String?       @unique
  referenceId    String?
  idempotencyKey String?       @unique
  checkoutUrl    String?
  failureReason  String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  paidAt         DateTime?
  verifiedAt     DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([gateway, status, createdAt])
}

model Banner {
  id            String          @id @default(uuid())
  placement     BannerPlacement
  titleFa       String?
  titleEn       String?
  subtitleFa    String?
  subtitleEn    String?
  imageUrl      String
  actionLabelFa String?
  actionLabelEn String?
  actionUrl     String?
  enabled       Boolean         @default(true)
  sortOrder     Int             @default(100)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([placement, enabled, sortOrder])
}

model Coupon {
  id             String             @id @default(uuid())
  code           String             @unique
  title          String?
  discountType   CouponDiscountType
  discountValue  Decimal            @db.Decimal(20, 4)
  minOrderAfn    BigInt             @default(0)
  maxDiscountAfn BigInt?
  usageLimit     Int?
  usedCount      Int                @default(0)
  active         Boolean            @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([active, startsAt, endsAt])
}

model Notification {
  id                 String               @id @default(uuid())
  userId             String?
  audience           NotificationAudience @default(ALL)
  type               NotificationType     @default(SYSTEM)
  priority           NotificationPriority @default(NORMAL)
  titleFa            String
  titleEn            String
  bodyFa             String
  bodyEn             String
  actionRoute        String?
  actionEntityId     String?
  actionLabelFa      String?
  actionLabelEn      String?
  imageUrl           String?
  metadata           Json?
  enabled            Boolean              @default(true)
  publishAt          DateTime             @default(now())
  expiresAt          DateTime?
  pushTotal          Int                  @default(0)
  pushSent           Int                  @default(0)
  pushFailed         Int                  @default(0)
  pushDisabledTokens Int                  @default(0)
  lastPushAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user  User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reads NotificationRead[]

  @@index([audience, enabled, publishAt])
  @@index([userId, publishAt])
  @@index([type, publishAt])
  @@index([enabled, publishAt, lastPushAt])
}

model NotificationRead {
  id             String   @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

model PushDevice {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String   @default("ANDROID")
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@index([enabled, lastSeenAt])
}

model SupportTicket {
  id            String        @id @default(uuid())
  userId        String
  subject       String
  status        SupportStatus @default(OPEN)
  priority      Int           @default(0)
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([userId, createdAt])
}

model SupportMessage {
  id           String   @id @default(uuid())
  ticketId     String
  senderUserId String?
  isAdmin      Boolean  @default(false)
  content      String
  createdAt    DateTime @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser User?         @relation("SupportSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  category    String   @default("general")
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, key])
}

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  entityType  String
  entityId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser User @relation("AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}
