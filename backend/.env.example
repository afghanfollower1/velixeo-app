NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://velixeo:velixeo@localhost:5432/velixeo?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Google Sign-In. Use the OAuth Web Client ID (not the Android client ID).
GOOGLE_WEB_CLIENT_ID=

# Public HTTPS origin used for payment return and webhook URLs in deployed environments.
# Example: https://velixeo-api-production.up.railway.app
PUBLIC_BASE_URL=

# Provider API secrets are encrypted before they are stored in PostgreSQL.
# Supply exactly 32 random bytes encoded as 64 hex characters or Base64.
# Never commit the real value.
ADMIN_SECRET_ENCRYPTION_KEY=

# HesabPay wallet top-up gateway. Keep sandbox until an end-to-end sandbox payment is verified.
HESABPAY_ENVIRONMENT=sandbox
HESABPAY_API_KEY=
# Optional override; when blank the backend selects the official sandbox/production host.
HESABPAY_API_BASE_URL=
HESABPAY_TIMEOUT_MS=15000

# VELIXEO credits the wallet only after the backend verifies the HesabPay webhook signature,
# matches the stored AFN amount, and records an idempotent ledger entry.
# Webhook path: /api/v1/payments/hesabpay/webhook
